# fal.ai API key — get one at https://fal.ai/dashboard/keys
FAL_KEY=

# Local only: set to 1 to enable sharp sketch preprocess.
# Leave unset/0 on Render Docker — sharp caused exit 139 (segfault).
# ENABLE_SHARP=1


# SQLite database path (relative to project root)
DATABASE_URL=file:./data/photoreal.db

# Display: USD → PKR rate (fal bills in USD; UI shows PKR)
USD_PKR_RATE=278

# Optional access password for shared/online use (numeric OK for a tiny group).
# Leave empty for local-only (no unlock screen).
SITE_PASSWORD=

# Optional: separate signing secret for the auth cookie (defaults to SITE_PASSWORD)
AUTH_SECRET=

# DeepSeek — polishes messy user notes before fal generation (cheap; fal still does images)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
